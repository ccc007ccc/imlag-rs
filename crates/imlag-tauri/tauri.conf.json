{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ImLag",
  "version": "0.1.1",
  "identifier": "dev.ccc007ccc.imlag",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ImLag",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": [18, 20, 28, 195]
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "CS2 死后自动狡辩工具",
    "longDescription": "ImLag listens to CS2 GSI and auto-sends excuses on death."
  }
}
